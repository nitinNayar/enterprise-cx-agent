# Anthropic API Key
ANTHROPIC_API_KEY=

# Phoenix Cloud Configuration (optional - leave empty for local Phoenix)
# Get these from Phoenix Cloud: https://app.phoenix.arize.com
# 1. Create a space
# 2. Go to Settings > Keys > Add System Key
# 3. Copy the API Key (starts with phx_)
# 4. Go to Settings and copy your Space ID (looks like: U3BhY2U6...)
PHOENIX_API_KEY=
PHOENIX_SPACE_ID=
PHOENIX_PROJECT_NAME=enterprise-cx-agent